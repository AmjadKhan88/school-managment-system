generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- PHASE 1: identity, RBAC, sessions, audit ----------------

model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  website   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches         Branch[]
  users            User[]
  roles            Role[]
  academicSessions AcademicSession[]
  settings         SchoolSetting[]
  auditLogs        AuditLog[]

  @@map("schools")
}

model Branch {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  code      String
  address   String?
  phone     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  users  User[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("branches")
}

model User {
  id                 String    @id @default(cuid())
  schoolId           String
  branchId           String?
  email              String    @unique
  fullName           String
  phone              String?
  passwordHash       String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  school          School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles       UserRole[]
  refreshTokens   RefreshToken[]
  loginHistory    LoginHistory[]
  auditLogs       AuditLog[]
  studentProfile  Student?       @relation("StudentLogin")
  guardianProfile Guardian?      @relation("GuardianLogin")
  employee        Employee?

  @@index([schoolId])
  @@index([schoolId, isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([schoolId, slug])
  @@index([schoolId])
  @@map("roles")
}

model Permission {
  id     String           @id @default(cuid())
  module String
  action PermissionAction

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  EXPORT
  PRINT
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email, createdAt])
  @@map("login_history")
}

model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school                  School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  enrollments             Enrollment[]
  feeStructures           FeeStructure[]
  exams                   Exam[]
  classTeacherAssignments ClassTeacherAssignment[]
  teacherAssignments      TeacherAssignment[]
  timetablePeriods        TimetablePeriod[]
  timetableEntries        TimetableEntry[]
  timetableConfig         TimetableConfig?

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("academic_sessions")
}

model SchoolSetting {
  id       String @id @default(cuid())
  schoolId String
  key      String
  value    String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
  @@map("school_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------- PHASE 2A: academic structure ----------------

model Class {
  id        String   @id @default(cuid())
  name      String   @unique
  level     Int      @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections Section[]
  subjects ClassSubject[]

  enrollments             Enrollment[]
  enquiries               AdmissionEnquiry[]
  feeStructures           FeeStructure[]
  feeInvoices             FeeInvoice[]
  attendance              StudentAttendance[]
  examClasses             ExamClass[]
  examSubjects            ExamSubject[]
  examResults             ExamResult[]
  classTeacherAssignments ClassTeacherAssignment[]
  teacherAssignments      TeacherAssignment[]
  timetableEntries        TimetableEntry[]

  @@map("classes")
}

model Section {
  id        String   @id @default(cuid())
  classId   String
  name      String
  capacity  Int      @default(40)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class                   Class                    @relation(fields: [classId], references: [id], onDelete: Restrict)
  enrollments             Enrollment[]
  feeInvoices             FeeInvoice[]
  attendance              StudentAttendance[]
  classTeacherAssignments ClassTeacherAssignment[]
  teacherAssignments      TeacherAssignment[]
  timetableEntries        TimetableEntry[]

  @@unique([classId, name])
  @@map("sections")
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes            ClassSubject[]
  examSubjects       ExamSubject[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]

  @@map("subjects")
}

model ClassSubject {
  id        String @id @default(cuid())
  classId   String
  subjectId String

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// ---------------- PHASE 2B: students, admissions, promotion ----------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  PASSED_OUT
  TRANSFERRED
  LEFT
}

enum EnrollmentStatus {
  ENROLLED
  PROMOTED
  REPEATED
  GRADUATED
  TRANSFERRED
  LEFT
}

enum PromotionOutcome {
  PROMOTED
  REPEATED
  GRADUATED
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum DocumentType {
  BIRTH_CERTIFICATE
  B_FORM
  PREVIOUS_RESULT
  TRANSFER_CERTIFICATE
  PHOTO
  OTHER
}

enum EnquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  ADMISSION_PENDING
  ADMITTED
  REJECTED
}

// Generates admission numbers safely (ADM-2026-0001), incremented inside a transaction.
model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}

model Student {
  id               String        @id @default(cuid())
  admissionNo      String        @unique
  fullName         String
  fatherName       String
  motherName       String?
  dateOfBirth      DateTime      @db.Date
  gender           Gender
  bloodGroup       String?
  nationality      String        @default("Pakistani")
  religion         String?
  bFormNo          String?       @unique
  photoUrl         String?
  previousSchool   String?
  admissionDate    DateTime      @db.Date
  status           StudentStatus @default(ACTIVE)
  permanentAddress String?
  currentAddress   String?
  city             String?
  postalCode       String?
  medicalNotes     String?
  needsTransport   Boolean       @default(false)
  emergencyName    String?
  emergencyPhone   String?
  remarks          String?
  userId           String?       @unique // student portal login
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user              User?               @relation("StudentLogin", fields: [userId], references: [id], onDelete: SetNull)
  guardians         StudentGuardian[]
  documents         StudentDocument[]
  enrollments       Enrollment[]
  promotions        StudentPromotion[]
  transfers         StudentTransfer[]
  feeInvoices       FeeInvoice[]
  feePayments       FeePayment[]
  feeReminders      FeeReminder[]
  feeRefunds        FeeRefund[]
  attendance        StudentAttendance[]
  leaveApplications LeaveApplication[]
  examMarks         ExamMark[]
  examResults       ExamResult[]
  reportCardRemarks ReportCardRemark[]
  admission         Admission?

  @@index([fullName, dateOfBirth]) // duplicate detection
  @@index([status])
  @@map("students")
}

// A guardian can be linked to several children (siblings share one record).
model Guardian {
  id         String   @id @default(cuid())
  fullName   String
  phone      String
  email      String?
  occupation String?
  userId     String?  @unique // parent portal login
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?             @relation("GuardianLogin", fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@index([phone])
  @@map("guardians")
}

model StudentGuardian {
  studentId  String
  guardianId String
  relation   GuardianRelation
  isPrimary  Boolean          @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model StudentDocument {
  id           String       @id @default(cuid())
  studentId    String
  type         DocumentType
  fileName     String
  filePath     String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime     @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

// One row per student per session: this is the academic history.
model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  sessionId String
  classId   String
  sectionId String
  rollNo    Int?
  status    EnrollmentStatus @default(ENROLLED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student       Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  session       AcademicSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  class         Class                 @relation(fields: [classId], references: [id], onDelete: Restrict)
  section       Section               @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  feeAssignment StudentFeeAssignment?
  feeInvoices   FeeInvoice[]
  feeDiscounts  FeeDiscount[]
  attendance    StudentAttendance[]
  examMarks     ExamMark[]
  examResults   ExamResult[]

  @@unique([studentId, sessionId]) // one class per student per session
  @@unique([sessionId, sectionId, rollNo]) // no duplicate roll numbers in a section
  @@index([sessionId, classId, sectionId])
  @@map("enrollments")
}

model StudentPromotion {
  id               String           @id @default(cuid())
  batchId          String // groups one bulk promotion run
  studentId        String
  fromEnrollmentId String           @unique
  toEnrollmentId   String?          @unique // empty when repeated-in-place or graduated
  outcome          PromotionOutcome
  remarks          String?
  promotedById     String?
  createdAt        DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@map("student_promotions")
}

model AdmissionEnquiry {
  id                String        @id @default(cuid())
  enquiryNo         String        @unique
  studentName       String
  fatherName        String
  phone             String
  email             String?
  dateOfBirth       DateTime?     @db.Date
  gender            Gender?
  interestedClassId String?
  previousSchool    String?
  address           String?
  enquiryDate       DateTime      @db.Date
  source            String?
  remarks           String?
  followUpDate      DateTime?     @db.Date
  status            EnquiryStatus @default(NEW)
  admissionId       String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  interestedClass Class?     @relation(fields: [interestedClassId], references: [id], onDelete: SetNull)
  admission       Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  @@index([status, followUpDate])
  @@map("admission_enquiries")
}

// Records the intake event: who admitted whom, into which session.
model Admission {
  id            String   @id @default(cuid())
  studentId     String   @unique
  sessionId     String
  admittedById  String?
  admissionDate DateTime @db.Date
  remarks       String?
  createdAt     DateTime @default(now())

  student Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enquiry AdmissionEnquiry?

  @@map("admissions")
}

// ---------------- PHASE 2C: transfers ----------------

enum TransferType {
  INTERNAL
  OUT
}

// Permanent log: an in-session class/section move keeps its "from" values here.
model StudentTransfer {
  id                String       @id @default(cuid())
  studentId         String
  enrollmentId      String
  sessionId         String
  type              TransferType
  fromClassId       String
  fromSectionId     String
  fromRollNo        Int?
  toClassId         String?
  toSectionId       String?
  toRollNo          Int?
  transferDate      DateTime     @db.Date
  reason            String?
  destinationSchool String?
  certificateNo     String?      @unique // leaving certificate number (OUT transfers)
  performedById     String?
  createdAt         DateTime     @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([sessionId, type])
  @@map("student_transfers")
}

// ---------------- PHASE 3A: fee categories, structures, assignments ----------------

enum FeeFrequency {
  MONTHLY
  ONE_TIME
  YEARLY
}

enum FineType {
  NONE
  FIXED
  PER_DAY
}

model FeeCategory {
  id        String       @id @default(cuid())
  name      String       @unique
  code      String       @unique
  frequency FeeFrequency
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  structureItems FeeStructureItem[]
  overrides      StudentFeeOverride[]
  invoiceItems   FeeInvoiceItem[]
  discounts      FeeDiscount[]

  @@map("fee_categories")
}

// One price list per class per session.
model FeeStructure {
  id         String   @id @default(cuid())
  sessionId  String
  classId    String
  dueDay     Int      @default(10) // day of month fees fall due
  fineType   FineType @default(NONE)
  fineAmount Decimal  @default(0) @db.Decimal(14, 2)
  graceDays  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session     AcademicSession        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  class       Class                  @relation(fields: [classId], references: [id], onDelete: Restrict)
  items       FeeStructureItem[]
  assignments StudentFeeAssignment[]

  @@unique([sessionId, classId])
  @@map("fee_structures")
}

model FeeStructureItem {
  id          String  @id @default(cuid())
  structureId String
  categoryId  String
  amount      Decimal @db.Decimal(14, 2)

  structure FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  category  FeeCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([structureId, categoryId])
  @@map("fee_structure_items")
}

// Links one enrollment (student + session) to a price list.
model StudentFeeAssignment {
  id           String   @id @default(cuid())
  enrollmentId String   @unique
  structureId  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  structure  FeeStructure         @relation(fields: [structureId], references: [id], onDelete: Restrict)
  overrides  StudentFeeOverride[]

  @@index([structureId])
  @@map("student_fee_assignments")
}

// Per-student price for one category. Amount 0 waives the fee.
model StudentFeeOverride {
  id           String  @id @default(cuid())
  assignmentId String
  categoryId   String
  amount       Decimal @db.Decimal(14, 2)
  reason       String?

  assignment StudentFeeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  category   FeeCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, categoryId])
  @@map("student_fee_overrides")
}

// ---------------- PHASE 3B: invoices and discounts ----------------

enum InvoiceStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

enum DiscountKind {
  DISCOUNT
  SCHOLARSHIP
}

enum DiscountMode {
  PERCENT
  FIXED
}

enum DiscountStatus {
  PENDING
  APPROVED
  REVOKED
}

// Invoices are never deleted. totalAmount = subtotal - discountTotal + fineAmount.
// paidAmount is changed only by payment allocation (next step), inside the payment transaction.
model FeeInvoice {
  id              String        @id @default(cuid())
  invoiceNo       String        @unique
  enrollmentId    String
  studentId       String
  sessionId       String
  classId         String // class/section at billing time, kept for reports
  sectionId       String
  periodKey       String // "2026-11"
  periodLock      String?       @unique // enrollmentId:periodKey while active; null once cancelled
  issueDate       DateTime      @db.Date
  dueDate         DateTime      @db.Date
  subtotal        Decimal       @db.Decimal(14, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(14, 2)
  fineAmount      Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal       @db.Decimal(14, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(14, 2)
  previousBalance Decimal       @default(0) @db.Decimal(14, 2) // informational snapshot, not part of totalAmount
  fineType        FineType      @default(NONE)
  fineRate        Decimal       @default(0) @db.Decimal(14, 2)
  graceDays       Int           @default(0)
  status          InvoiceStatus @default(OPEN)
  cancelledAt     DateTime?
  cancelReason    String?
  generatedById   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  enrollment  Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class       Class               @relation(fields: [classId], references: [id], onDelete: Restrict)
  section     Section             @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  items       FeeInvoiceItem[]
  allocations PaymentAllocation[]
  adjustments FeeAdjustment[]

  @@index([sessionId, periodKey])
  @@index([studentId])
  @@index([status, dueDate])
  @@map("fee_invoices")
}

model FeeInvoiceItem {
  id          String       @id @default(cuid())
  invoiceId   String
  categoryId  String
  description String // category name at billing time
  frequency   FeeFrequency
  amount      Decimal      @db.Decimal(14, 2)
  discount    Decimal      @default(0) @db.Decimal(14, 2)

  invoice  FeeInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  category FeeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([categoryId])
  @@map("fee_invoice_items")
}

// Discounts and scholarships apply only once APPROVED. Revoking never changes invoices already issued.
model FeeDiscount {
  id              String         @id @default(cuid())
  enrollmentId    String
  kind            DiscountKind
  categoryId      String? // null = all monthly fees
  mode            DiscountMode
  value           Decimal        @db.Decimal(14, 2)
  validFromPeriod String?
  validToPeriod   String?
  reason          String
  status          DiscountStatus @default(PENDING)
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  enrollment Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  category   FeeCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([enrollmentId, status])
  @@map("fee_discounts")
}

// ---------------- PHASE 3C: payments and receipts ----------------

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
  CHEQUE
  OTHER
}

enum PaymentKind {
  PAYMENT
  REVERSAL
}

enum PaymentStatus {
  POSTED
  REVERSED
}

// Payments are never edited or deleted. A mistake is corrected by a REVERSAL row.
// Reversal rows carry negative amounts so net collection = sum of all rows.
model FeePayment {
  id                String        @id @default(cuid())
  receiptNo         String        @unique
  kind              PaymentKind   @default(PAYMENT)
  status            PaymentStatus @default(POSTED)
  studentId         String
  paymentDate       DateTime      @db.Date
  totalAmount       Decimal       @db.Decimal(14, 2)
  unallocatedAmount Decimal       @default(0) @db.Decimal(14, 2) // advance credit still available
  duesBefore        Decimal       @default(0) @db.Decimal(14, 2)
  duesAfter         Decimal       @default(0) @db.Decimal(14, 2)
  notes             String?
  idempotencyKey    String?       @unique
  receivedById      String?
  reversesPaymentId String?       @unique // one reversal per payment
  reversalReason    String?
  reversedAt        DateTime?
  reversedById      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  student     Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  lines       FeePaymentLine[]
  allocations PaymentAllocation[]

  @@index([studentId])
  @@index([paymentDate])
  @@index([status])
  @@map("fee_payments")
}

model FeePaymentLine {
  id        String        @id @default(cuid())
  paymentId String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2)
  reference String?

  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("fee_payment_lines")
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

// ---------------- PHASE 3D: reminder log ----------------

// A record that a reminder was sent. Real delivery status arrives with the notifications phase.
model FeeReminder {
  id        String   @id @default(cuid())
  studentId String
  channel   String   @default("WHATSAPP")
  phone     String?
  message   String
  sentById  String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@map("fee_reminders")
}

// ---------------- PHASE 3E: adjustments and refunds ----------------

enum AdjustmentType {
  FINE_WAIVER
  EXTRA_DISCOUNT
}

enum RefundStatus {
  PENDING
  PAID
  REJECTED
}

// Each adjustment is a permanent record of a change made to an issued invoice.
model FeeAdjustment {
  id          String         @id @default(cuid())
  invoiceId   String
  studentId   String
  type        AdjustmentType
  amount      Decimal        @db.Decimal(14, 2)
  reason      String
  createdById String?
  createdAt   DateTime       @default(now())

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([studentId])
  @@map("fee_adjustments")
}

// Refund of advance credit. Money goes out only when an approver marks it PAID.
model FeeRefund {
  id              String        @id @default(cuid())
  refundNo        String        @unique
  studentId       String
  amount          Decimal       @db.Decimal(14, 2)
  method          PaymentMethod
  reference       String?
  reason          String
  status          RefundStatus  @default(PENDING)
  requestedById   String?
  decidedById     String?
  decidedAt       DateTime?
  rejectionReason String?
  paidDate        DateTime?     @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([status])
  @@index([paidDate])
  @@map("fee_refunds")
}

// ---------------- PHASE 3F: expenses and other income ----------------

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
}

enum IncomeSource {
  DONATION
  TRANSPORT
  RENTAL
  EVENT
  OTHER
}

enum IncomeStatus {
  ACTIVE
  VOIDED
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@map("expense_categories")
}

// Never deleted. Approved expenses are locked; a mistake is voided and re-entered.
model Expense {
  id              String        @id @default(cuid())
  expenseNo       String        @unique
  categoryId      String
  description     String
  amount          Decimal       @db.Decimal(14, 2)
  expenseDate     DateTime      @db.Date
  method          PaymentMethod
  paidTo          String?
  reference       String?
  status          ExpenseStatus @default(PENDING)
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  voidReason      String?
  voidedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category        ExpenseCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachments     ExpenseAttachment[]
  salaryPayment   SalaryPayment?
  staffLoanPayout StaffLoan?

  @@index([expenseDate])
  @@index([status])
  @@index([categoryId])
  @@map("expenses")
}

model ExpenseAttachment {
  id           String   @id @default(cuid())
  expenseId    String
  fileName     String
  storedName   String   @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@index([expenseId])
  @@map("expense_attachments")
}

// Income other than fees. Fee income comes from fee payments automatically.
model OtherIncome {
  id           String        @id @default(cuid())
  incomeNo     String        @unique
  source       IncomeSource
  description  String
  amount       Decimal       @db.Decimal(14, 2)
  incomeDate   DateTime      @db.Date
  method       PaymentMethod
  receivedFrom String?
  reference    String?
  status       IncomeStatus  @default(ACTIVE)
  voidReason   String?
  voidedAt     DateTime?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([incomeDate])
  @@index([status])
  @@map("other_income")
}

// ---------------- PHASE 4A: student attendance ----------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
}

// Class, section and session are copied onto each row so old reports stay correct after a student moves.
model StudentAttendance {
  id           String           @id @default(cuid())
  enrollmentId String
  studentId    String
  sessionId    String
  classId      String
  sectionId    String
  date         DateTime         @db.Date
  status       AttendanceStatus
  remarks      String?
  markedById   String?
  updatedById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Restrict)
  section    Section    @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([studentId, date]) // one record per student per day
  @@index([sessionId, classId, sectionId, date])
  @@index([date])
  @@map("student_attendance")
}

// ---------------- PHASE 4B: leave applications ----------------

enum LeaveApplicantType {
  STUDENT
  EMPLOYEE
}

enum LeaveType {
  SICK
  CASUAL
  EMERGENCY
  FAMILY
  ANNUAL
  MATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Applications are never deleted: they are approved, rejected or cancelled.
// employeeId is filled in Phase 5 when staff exist; students use studentId.
model LeaveApplication {
  id                 String             @id @default(cuid())
  applicationNo      String             @unique
  applicantType      LeaveApplicantType @default(STUDENT)
  studentId          String?
  employeeId         String?
  leaveType          LeaveType
  startDate          DateTime           @db.Date
  endDate            DateTime           @db.Date
  days               Int
  reason             String
  status             LeaveStatus        @default(PENDING)
  documentName       String?
  documentStoredName String?            @unique
  documentMime       String?
  documentSize       Int?
  submittedById      String?
  decidedById        String?
  decidedAt          DateTime?
  rejectionReason    String?
  cancelReason       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  student  Student?  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([studentId, status, startDate])
  @@index([status])
  @@index([startDate, endDate])
  @@index([employeeId, status, startDate])
  @@map("leave_applications")
}

// ---------------- PHASE 4C: grading and exam setup ----------------

enum ExamType {
  MONTHLY_TEST
  WEEKLY_TEST
  MIDTERM
  FINAL
  PRACTICAL
  ANNUAL
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

model GradingScale {
  id        String   @id @default(cuid())
  name      String   @unique
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bands GradeBand[]
  exams Exam[]

  @@map("grading_scales")
}

// A grade starts at minPercent and runs up to the next grade's minPercent.
model GradeBand {
  id         String  @id @default(cuid())
  scaleId    String
  grade      String
  minPercent Decimal @db.Decimal(5, 2)
  gradePoint Decimal @db.Decimal(3, 2)
  remark     String?

  scale GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, grade])
  @@unique([scaleId, minPercent])
  @@map("grade_bands")
}

model Exam {
  id             String     @id @default(cuid())
  name           String
  type           ExamType
  sessionId      String
  startDate      DateTime   @db.Date
  endDate        DateTime   @db.Date
  status         ExamStatus @default(DRAFT)
  gradingScaleId String? // null = use the default scale
  notes          String?
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  session      AcademicSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  gradingScale GradingScale?      @relation(fields: [gradingScaleId], references: [id], onDelete: Restrict)
  classes      ExamClass[]
  subjects     ExamSubject[]
  results      ExamResult[]
  remarks      ReportCardRemark[]

  @@unique([sessionId, name])
  @@index([sessionId, startDate])
  @@map("exams")
}

// Which classes sit the exam, with default marks for their papers.
model ExamClass {
  examId               String
  classId              String
  totalMarks           Int
  passingMarks         Int
  resultsPublishedAt   DateTime?
  resultsPublishedById String?

  exam  Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@id([examId, classId])
  @@map("exam_classes")
}

// One paper: a subject for a class in an exam. Date, time and room are filled in on the schedule.
model ExamSubject {
  id             String    @id @default(cuid())
  examId         String
  classId        String
  subjectId      String
  examDate       DateTime? @db.Date
  startTime      String? // "09:00"
  endTime        String?
  room           String?
  totalMarks     Int
  practicalMarks Int       @default(0) // part of totalMarks that is practical
  passingMarks   Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  exam    Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  class   Class      @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  marks   ExamMark[]

  @@unique([examId, classId, subjectId])
  @@index([examId, examDate])
  @@index([examDate, room])
  @@map("exam_subjects")
}

// ---------------- PHASE 4D: marks and results ----------------

enum MarkStatus {
  ENTERED
  ABSENT
  EXEMPT
}

enum ResultStatus {
  PASS
  FAIL
}

// One student's mark in one paper. grade, gradePoint and passed are a snapshot written when results are published.
model ExamMark {
  id            String     @id @default(cuid())
  examSubjectId String
  enrollmentId  String
  studentId     String
  status        MarkStatus @default(ENTERED)
  theory        Decimal?   @db.Decimal(6, 2)
  practical     Decimal?   @db.Decimal(6, 2)
  remarks       String?
  grade         String?
  gradePoint    Decimal?   @db.Decimal(3, 2)
  passed        Boolean?
  enteredById   String?
  updatedById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Restrict)
  enrollment  Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([examSubjectId, studentId])
  @@index([studentId])
  @@map("exam_marks")
}

// Published result for a student in an exam. Frozen when published; removed only by unpublishing.
model ExamResult {
  id             String       @id @default(cuid())
  examId         String
  classId        String
  enrollmentId   String
  studentId      String
  totalObtained  Decimal      @db.Decimal(8, 2)
  totalMax       Decimal      @db.Decimal(8, 2)
  percentage     Decimal?     @db.Decimal(5, 2)
  grade          String?
  gpa            Decimal?     @db.Decimal(3, 2)
  result         ResultStatus
  failedSubjects Int          @default(0)
  position       Int?
  publishedAt    DateTime     @default(now())
  publishedById  String?

  exam       Exam       @relation(fields: [examId], references: [id], onDelete: Restrict)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([examId, studentId])
  @@index([examId, classId])
  @@map("exam_results")
}

// ---------------- PHASE 4E: report card remarks ----------------

// Kept apart from ExamResult so remarks survive an unpublish and republish.
model ReportCardRemark {
  id               String   @id @default(cuid())
  examId           String
  studentId        String
  teacherRemarks   String?
  principalRemarks String?
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([examId, studentId])
  @@map("report_card_remarks")
}

// ---------------- PHASE 5A: staff ----------------

enum EmploymentType {
  PERMANENT
  CONTRACT
  PART_TIME
  VISITING
}

enum EmploymentStatus {
  ACTIVE
  RESIGNED
  TERMINATED
  RETIRED
}

model Designation {
  id         String   @id @default(cuid())
  name       String   @unique
  isTeaching Boolean  @default(false)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employees Employee[]

  @@map("designations")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@map("departments")
}

// Employees are never deleted: they leave (resigned, terminated, retired) and keep their history.
model Employee {
  id             String           @id @default(cuid())
  employeeNo     String           @unique
  fullName       String
  fatherName     String?
  gender         Gender
  dateOfBirth    DateTime?        @db.Date
  cnic           String?          @unique
  phone          String
  email          String?
  address        String?
  city           String?
  designationId  String
  departmentId   String?
  qualification  String?
  joiningDate    DateTime         @db.Date
  leavingDate    DateTime?        @db.Date
  employmentType EmploymentType   @default(PERMANENT)
  status         EmploymentStatus @default(ACTIVE)
  isTeacher      Boolean          @default(false)
  emergencyName  String?
  emergencyPhone String?
  photoUrl       String?
  basicSalary    Decimal?         @db.Decimal(14, 2) // visible only with payroll permission
  bankName       String?
  accountTitle   String?
  accountNo      String?
  userId         String?          @unique // login account, if any
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  designation       Designation              @relation(fields: [designationId], references: [id], onDelete: Restrict)
  department        Department?              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user              User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  history           EmployeeHistory[]
  classTeacherOf    ClassTeacherAssignment[]
  teaching          TeacherAssignment[]
  attendance        StaffAttendance[]
  leaveApplications LeaveApplication[]
  salaryItems       EmployeeSalaryItem[]
  payrolls          Payroll[]
  salaryPayments    SalaryPayment[]
  loans             StaffLoan[]
  timetableEntries  TimetableEntry[]

  @@index([status])
  @@index([isTeacher])
  @@index([designationId])
  @@map("employees")
}

model EmployeeHistory {
  id          String   @id @default(cuid())
  employeeId  String
  field       String
  oldValue    String?
  newValue    String?
  note        String?
  changedById String?
  changedAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, changedAt])
  @@map("employee_history")
}

// One class teacher per section per session.
model ClassTeacherAssignment {
  id         String   @id @default(cuid())
  sessionId  String
  classId    String
  sectionId  String
  employeeId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session  AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  class    Class           @relation(fields: [classId], references: [id], onDelete: Restrict)
  section  Section         @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([sessionId, sectionId])
  @@index([employeeId, sessionId])
  @@map("class_teacher_assignments")
}

// One subject teacher per subject per section per session.
model TeacherAssignment {
  id         String   @id @default(cuid())
  sessionId  String
  classId    String
  sectionId  String
  subjectId  String
  employeeId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session  AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  class    Class           @relation(fields: [classId], references: [id], onDelete: Restrict)
  section  Section         @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject  Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([sessionId, sectionId, subjectId])
  @@index([employeeId, sessionId])
  @@map("teacher_assignments")
}

// ---------------- PHASE 5B: staff attendance ----------------

model StaffAttendance {
  id          String           @id @default(cuid())
  employeeId  String
  date        DateTime         @db.Date
  status      AttendanceStatus
  checkIn     String? // "08:05"
  checkOut    String?
  remarks     String?
  markedById  String?
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date]) // one record per employee per day
  @@index([date])
  @@map("staff_attendance")
}

// ---------------- PHASE 5C: payroll ----------------

enum SalaryComponentType {
  ALLOWANCE
  DEDUCTION
}

enum PayrollStatus {
  DRAFT
  APPROVED
}

enum PayrollItemKind {
  BASIC
  ALLOWANCE
  BONUS
  OVERTIME
  DEDUCTION
  LOAN
  ABSENCE
}

enum SalaryPayMethod {
  CASH
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
  CHEQUE
  OTHER
}

enum LoanType {
  ADVANCE
  LOAN
}

enum LoanStatus {
  PENDING
  ACTIVE
  SETTLED
  REJECTED
  CANCELLED
}

// An allowance or deduction type. isPercent means the employee's value is a percentage of basic salary.
model SalaryComponent {
  id        String              @id @default(cuid())
  name      String              @unique
  type      SalaryComponentType
  isPercent Boolean             @default(false)
  sortOrder Int                 @default(0)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  employeeItems EmployeeSalaryItem[]

  @@map("salary_components")
}

model EmployeeSalaryItem {
  id          String   @id @default(cuid())
  employeeId  String
  componentId String
  value       Decimal  @db.Decimal(14, 2) // amount, or percent of basic
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([employeeId, componentId])
  @@map("salary_structures")
}

// One payroll per employee per month. Drafts are editable. Approved payroll is locked.
model Payroll {
  id                  String        @id @default(cuid())
  slipNo              String        @unique
  period              String // "2026-11"
  employeeId          String
  status              PayrollStatus @default(DRAFT)
  basicSalary         Decimal       @db.Decimal(14, 2)
  allowancesTotal     Decimal       @default(0) @db.Decimal(14, 2)
  bonus               Decimal       @default(0) @db.Decimal(14, 2)
  bonusNote           String?
  overtimeHours       Decimal       @default(0) @db.Decimal(6, 2)
  overtimeRate        Decimal       @default(0) @db.Decimal(10, 2)
  overtimeAmount      Decimal       @default(0) @db.Decimal(14, 2)
  deductionsTotal     Decimal       @default(0) @db.Decimal(14, 2)
  loanRecovery        Decimal       @default(0) @db.Decimal(14, 2)
  absenceDeduction    Decimal       @default(0) @db.Decimal(14, 2)
  netSalary           Decimal       @db.Decimal(14, 2)
  paidAmount          Decimal       @default(0) @db.Decimal(14, 2)
  presentDays         Int           @default(0)
  halfDays            Int           @default(0)
  absentDays          Int           @default(0)
  paidLeaveDays       Int           @default(0)
  unpaidLeaveDays     Int           @default(0)
  uncoveredLeaveDays  Int           @default(0)
  outsideDays         Int           @default(0)
  recordedDays        Int           @default(0)
  computedAbsenceDays Decimal       @default(0) @db.Decimal(5, 2)
  absenceDays         Decimal       @default(0) @db.Decimal(5, 2)
  absenceOverridden   Boolean       @default(false)
  absenceNote         String?
  generatedById       String?
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items      PayrollItem[]
  payments   SalaryPayment[]
  recoveries LoanRecovery[]

  @@unique([employeeId, period]) // no duplicate payroll for the same employee and month
  @@index([period, status])
  @@map("payrolls")
}

model PayrollItem {
  id        String          @id @default(cuid())
  payrollId String
  kind      PayrollItemKind
  label     String
  amount    Decimal         @db.Decimal(14, 2)
  loanId    String?
  sortOrder Int             @default(0)

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@map("payroll_items")
}

// Never deleted. A mistaken payment is reversed with a reason.
model SalaryPayment {
  id            String          @id @default(cuid())
  receiptNo     String          @unique
  payrollId     String
  employeeId    String
  amount        Decimal         @db.Decimal(14, 2)
  paidOn        DateTime        @db.Date
  method        SalaryPayMethod
  reference     String?
  note          String?
  paidById      String?
  reversedAt    DateTime?
  reversedById  String?
  reverseReason String?
  expenseId     String?         @unique
  createdAt     DateTime        @default(now())

  payroll  Payroll  @relation(fields: [payrollId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  expense  Expense? @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@index([paidOn])
  @@index([payrollId])
  @@map("salary_payments")
}

model StaffLoan {
  id               String           @id @default(cuid())
  loanNo           String           @unique
  employeeId       String
  type             LoanType
  amount           Decimal          @db.Decimal(14, 2)
  instalments      Int
  instalmentAmount Decimal          @db.Decimal(14, 2)
  startPeriod      String // first month to recover, "2026-12"
  reason           String?
  status           LoanStatus       @default(PENDING)
  requestedById    String?
  decidedById      String?
  decidedAt        DateTime?
  rejectionReason  String?
  cancelReason     String?
  issuedOn         DateTime?        @db.Date
  issueMethod      SalaryPayMethod?
  issueReference   String?
  payoutExpenseId  String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payoutExpense Expense?       @relation(fields: [payoutExpenseId], references: [id], onDelete: Restrict)
  recoveries    LoanRecovery[]

  @@index([employeeId, status])
  @@map("staff_loans")
}

// A repayment taken from a payroll. Voided (never deleted) if that payroll is reopened.
model LoanRecovery {
  id        String    @id @default(cuid())
  loanId    String
  payrollId String
  period    String
  amount    Decimal   @db.Decimal(14, 2)
  voidedAt  DateTime?
  createdAt DateTime  @default(now())

  loan    StaffLoan @relation(fields: [loanId], references: [id], onDelete: Restrict)
  payroll Payroll   @relation(fields: [payrollId], references: [id], onDelete: Restrict)

  @@unique([loanId, payrollId])
  @@index([period])
  @@map("loan_recoveries")
}

// ---------------- PHASE 4F: timetable ----------------

model TimetableConfig {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  workingDays Int[] // ISO weekdays: 1 = Monday ... 7 = Sunday
  updatedAt   DateTime @updatedAt

  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@map("timetable_config")
}

model Room {
  id        String   @id @default(cuid())
  name      String   @unique
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries TimetableEntry[]

  @@map("rooms")
}

// The bell schedule of a session. Break periods hold no classes.
model TimetablePeriod {
  id        String   @id @default(cuid())
  sessionId String
  sortOrder Int
  name      String
  startTime String // "08:00"
  endTime   String
  isBreak   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session AcademicSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  entries TimetableEntry[]

  @@unique([sessionId, sortOrder])
  @@map("timetable_periods")
}

// One subject for one section in one period on one weekday.
// The three unique rules also hold in the database: a section, a teacher and a room can each be in one place per period.
model TimetableEntry {
  id         String   @id @default(cuid())
  sessionId  String
  classId    String
  sectionId  String
  dayOfWeek  Int // 1 = Monday ... 7 = Sunday
  periodId   String
  subjectId  String
  employeeId String?
  roomId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session  AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  class    Class           @relation(fields: [classId], references: [id], onDelete: Restrict)
  section  Section         @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  period   TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  subject  Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  employee Employee?       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  room     Room?           @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([sessionId, sectionId, dayOfWeek, periodId])
  @@unique([sessionId, employeeId, dayOfWeek, periodId])
  @@unique([sessionId, roomId, dayOfWeek, periodId])
  @@index([sectionId])
  @@index([employeeId])
  @@map("timetable_entries")
}
