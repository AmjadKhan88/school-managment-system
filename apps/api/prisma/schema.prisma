generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- PHASE 1: identity, RBAC, sessions, audit ----------------

model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  website   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches         Branch[]
  users            User[]
  roles            Role[]
  academicSessions AcademicSession[]
  settings         SchoolSetting[]
  auditLogs        AuditLog[]

  @@map("schools")
}

model Branch {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  code      String
  address   String?
  phone     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  users  User[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("branches")
}

model User {
  id                 String    @id @default(cuid())
  schoolId           String
  branchId           String?
  email              String    @unique
  fullName           String
  phone              String?
  passwordHash       String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  school          School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles       UserRole[]
  refreshTokens   RefreshToken[]
  loginHistory    LoginHistory[]
  auditLogs       AuditLog[]
  studentProfile  Student?       @relation("StudentLogin")
  guardianProfile Guardian?      @relation("GuardianLogin")

  @@index([schoolId])
  @@index([schoolId, isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([schoolId, slug])
  @@index([schoolId])
  @@map("roles")
}

model Permission {
  id     String           @id @default(cuid())
  module String
  action PermissionAction

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  EXPORT
  PRINT
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email, createdAt])
  @@map("login_history")
}

model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("academic_sessions")
}

model SchoolSetting {
  id       String @id @default(cuid())
  schoolId String
  key      String
  value    String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
  @@map("school_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------- PHASE 2A: academic structure ----------------

model Class {
  id        String   @id @default(cuid())
  name      String   @unique
  level     Int      @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections Section[]
  subjects ClassSubject[]

  enrollments Enrollment[]
  enquiries   AdmissionEnquiry[]

  @@map("classes")
}

model Section {
  id        String   @id @default(cuid())
  classId   String
  name      String
  capacity  Int      @default(40)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]

  @@unique([classId, name])
  @@map("sections")
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes ClassSubject[]

  @@map("subjects")
}

model ClassSubject {
  id        String @id @default(cuid())
  classId   String
  subjectId String

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// ---------------- PHASE 2B: students, admissions, promotion ----------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  PASSED_OUT
  TRANSFERRED
  LEFT
}

enum EnrollmentStatus {
  ENROLLED
  PROMOTED
  REPEATED
  GRADUATED
  TRANSFERRED
  LEFT
}

enum PromotionOutcome {
  PROMOTED
  REPEATED
  GRADUATED
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum DocumentType {
  BIRTH_CERTIFICATE
  B_FORM
  PREVIOUS_RESULT
  TRANSFER_CERTIFICATE
  PHOTO
  OTHER
}

enum EnquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  ADMISSION_PENDING
  ADMITTED
  REJECTED
}

// Generates admission numbers safely (ADM-2026-0001), incremented inside a transaction.
model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}

model Student {
  id               String        @id @default(cuid())
  admissionNo      String        @unique
  fullName         String
  fatherName       String
  motherName       String?
  dateOfBirth      DateTime      @db.Date
  gender           Gender
  bloodGroup       String?
  nationality      String        @default("Pakistani")
  religion         String?
  bFormNo          String?       @unique
  photoUrl         String?
  previousSchool   String?
  admissionDate    DateTime      @db.Date
  status           StudentStatus @default(ACTIVE)
  permanentAddress String?
  currentAddress   String?
  city             String?
  postalCode       String?
  medicalNotes     String?
  needsTransport   Boolean       @default(false)
  emergencyName    String?
  emergencyPhone   String?
  remarks          String?
  userId           String?       @unique // student portal login
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user        User?              @relation("StudentLogin", fields: [userId], references: [id], onDelete: SetNull)
  guardians   StudentGuardian[]
  documents   StudentDocument[]
  enrollments Enrollment[]
  promotions  StudentPromotion[]
  transfers   StudentTransfer[]
  admission   Admission?

  @@index([fullName, dateOfBirth]) // duplicate detection
  @@index([status])
  @@map("students")
}

// A guardian can be linked to several children (siblings share one record).
model Guardian {
  id         String   @id @default(cuid())
  fullName   String
  phone      String
  email      String?
  occupation String?
  userId     String?  @unique // parent portal login
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?             @relation("GuardianLogin", fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@index([phone])
  @@map("guardians")
}

model StudentGuardian {
  studentId  String
  guardianId String
  relation   GuardianRelation
  isPrimary  Boolean          @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model StudentDocument {
  id           String       @id @default(cuid())
  studentId    String
  type         DocumentType
  fileName     String
  filePath     String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime     @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

// One row per student per session: this is the academic history.
model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  sessionId String
  classId   String
  sectionId String
  rollNo    Int?
  status    EnrollmentStatus @default(ENROLLED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  class   Class           @relation(fields: [classId], references: [id], onDelete: Restrict)
  section Section         @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([studentId, sessionId]) // one class per student per session
  @@unique([sessionId, sectionId, rollNo]) // no duplicate roll numbers in a section
  @@index([sessionId, classId, sectionId])
  @@map("enrollments")
}

model StudentPromotion {
  id               String           @id @default(cuid())
  batchId          String // groups one bulk promotion run
  studentId        String
  fromEnrollmentId String           @unique
  toEnrollmentId   String?          @unique // empty when repeated-in-place or graduated
  outcome          PromotionOutcome
  remarks          String?
  promotedById     String?
  createdAt        DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@map("student_promotions")
}

model AdmissionEnquiry {
  id                String        @id @default(cuid())
  enquiryNo         String        @unique
  studentName       String
  fatherName        String
  phone             String
  email             String?
  dateOfBirth       DateTime?     @db.Date
  gender            Gender?
  interestedClassId String?
  previousSchool    String?
  address           String?
  enquiryDate       DateTime      @db.Date
  source            String?
  remarks           String?
  followUpDate      DateTime?     @db.Date
  status            EnquiryStatus @default(NEW)
  admissionId       String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  interestedClass Class?     @relation(fields: [interestedClassId], references: [id], onDelete: SetNull)
  admission       Admission? @relation(fields: [admissionId], references: [id], onDelete: SetNull)

  @@index([status, followUpDate])
  @@map("admission_enquiries")
}

// Records the intake event: who admitted whom, into which session.
model Admission {
  id            String   @id @default(cuid())
  studentId     String   @unique
  sessionId     String
  admittedById  String?
  admissionDate DateTime @db.Date
  remarks       String?
  createdAt     DateTime @default(now())

  student Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enquiry AdmissionEnquiry?

  @@map("admissions")
}

// ---------------- PHASE 2C: transfers ----------------

enum TransferType {
  INTERNAL
  OUT
}

// Permanent log: an in-session class/section move keeps its "from" values here.
model StudentTransfer {
  id                String       @id @default(cuid())
  studentId         String
  enrollmentId      String
  sessionId         String
  type              TransferType
  fromClassId       String
  fromSectionId     String
  fromRollNo        Int?
  toClassId         String?
  toSectionId       String?
  toRollNo          Int?
  transferDate      DateTime     @db.Date
  reason            String?
  destinationSchool String?
  certificateNo     String?      @unique // leaving certificate number (OUT transfers)
  performedById     String?
  createdAt         DateTime     @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([sessionId, type])
  @@map("student_transfers")
}
